<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CineXplora" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_accent_primary</item>
        <item name="colorPrimaryVariant">@color/dark_accent_primary_variant</item>
        <item name="colorOnPrimary">@color/dark_on_accent</item>
        <item name="colorSecondary">@color/dark_accent_secondary</item>
        <item name="colorOnSecondary">@color/dark_on_accent</item>

        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_elevated</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>

        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorHint">@color/dark_text_disabled</item>

        <item name="colorControlNormal">@color/dark_text_secondary</item>
        <item name="colorControlActivated">@color/dark_accent_primary</item>
        <item name="colorError">@color/dark_error</item>

        <item name="android:statusBarColor">@color/dark_background</item>
