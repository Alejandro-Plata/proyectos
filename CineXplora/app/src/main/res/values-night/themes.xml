        <item name="android:listDivider">@color/dark_divider</item>

        <item name="accentGlow">@color/dark_accent_glow</item>
        <item name="badgeMovie">@color/dark_badge_movie</item>
        <item name="badgeSerie">@color/dark_badge_serie</item>
        <item name="errorSurface">@color/dark_error_surface</item>
        <item name="successColor">@color/dark_success</item>
        <item name="successSurface">@color/dark_success_surface</item>
        <item name="surfaceElevated">@color/dark_surface_elevated</item>

        <item name="textInputStyle">@style/CineXplora.TextInputLayout</item>
        <item name="materialButtonStyle">@style/CineXplora.Button</item>
        <item name="materialCardViewStyle">@style/CineXplora.Card</item>
        <item name="alertDialogTheme">@style/CineXplora.AlertDialog</item>
    </style>
</resources>
