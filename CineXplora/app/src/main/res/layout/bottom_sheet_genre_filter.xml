<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="?android:attr/listDivider" />

    <!-- Header: título + Limpiar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">

        <TextView
            style="@style/CineXplora.Text.Overline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_genre" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearGenre"
            style="@style/CineXplora.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_filters"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Chips de género (wrap, selección única) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        app:chipSpacingHorizontal="@dimen/space_xs"
        app:chipSpacingVertical="@dimen/space_xs"
        app:singleSelection="true"
        app:selectionRequired="true" />

    <!-- CTA Aplicar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyGenre"
        style="@style/CineXplora.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_2xl"
        android:text="@string/btn_apply_filters" />

</LinearLayout>
