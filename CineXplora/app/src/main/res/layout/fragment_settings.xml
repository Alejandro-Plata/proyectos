<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_2xl">

        <!-- Title -->
        <TextView
            style="@style/CineXplora.Text.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:layout_marginBottom="@dimen/space_xl" />

        <!-- ===== PERFIL ===== -->
        <TextView
            style="@style/CineXplora.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_profile"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CineXplora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <!-- Avatar + photo button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/space_md">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileSettings"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeWidth="2dp"
                        app:strokeColor="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePhoto"
                        style="@style/CineXplora.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_change_photo"
                        app:icon="@drawable/ic_add_photo"
                        app:iconSize="16dp"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"
                    android:layout_marginBottom="@dimen/space_md" />

                <!-- Username -->
                <TextView
                    style="@style/CineXplora.Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_username"
                    android:layout_marginBottom="@dimen/space_xs" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_username_placeholder"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== PREFERENCIAS ===== -->
        <TextView
            style="@style/CineXplora.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_preferences"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CineXplora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Language row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_preferred_language"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerLanguage"
                        android:layout_width="140dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_outline"
                        android:paddingStart="@dimen/space_md" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"
                    android:layout_marginHorizontal="@dimen/space_lg" />

                <!-- Appearance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingBottom="@dimen/space_lg">

                    <TextView
                        style="@style/CineXplora.Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_appearance"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnLight">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLight"
                            style="@style/CineXplora.Button.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_light"
                            app:icon="@drawable/ic_sun"
                            app:iconSize="16dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDark"
                            style="@style/CineXplora.Button.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_dark"
                            app:icon="@drawable/ic_moon"
                            app:iconSize="16dp"
                            app:iconTint="?attr/colorPrimary" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== DATOS ===== -->
        <TextView
            style="@style/CineXplora.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_data"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CineXplora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_md">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_wifi_off"
                    android:layout_marginEnd="@dimen/space_md"
                    app:tint="?attr/colorPrimary"
                    android:alpha="0.85" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_wifi_only"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/CineXplora.Text.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_wifi_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track"
                    app:trackDecorationTint="@android:color/transparent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== ACTION BUTTONS ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/CineXplora.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_save_preferences"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/CineXplora.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset_defaults"
            android:textColor="?attr/colorError"
            android:layout_marginBottom="@dimen/space_2xl" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="@dimen/space_xl" />

        <!-- ===== CUENTA ===== -->
        <TextView
            style="@style/CineXplora.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_account"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/CineXplora.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_logout"
            app:backgroundTint="?attr/colorError"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            android:layout_marginBottom="@dimen/space_lg" />

    </LinearLayout>
</ScrollView>
