<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa de resplandor dorado -->
    <item android:top="2dp" android:left="4dp" android:right="4dp">
        <shape>
            <solid android:color="?attr/accentGlow" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- Botón real encima con degradado dorado -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="@color/gold_gradient_start"
                android:centerColor="@color/gold_gradient_mid"
                android:endColor="@color/gold_gradient_end"
                android:type="linear" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</layer-list>
