<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/surfaceElevated" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- Estado pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D4A830"
                android:centerColor="#B8962E"
                android:endColor="#7A5D18"
                android:type="linear" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/gold_gradient_start"
                android:centerColor="@color/gold_gradient_mid"
                android:endColor="@color/gold_gradient_end"
                android:type="linear" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
