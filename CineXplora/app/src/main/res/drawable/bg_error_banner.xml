<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo -->
    <item>
        <shape>
            <solid android:color="?attr/errorSurface" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- Barra lateral izquierda roja -->
    <item android:right="999dp">
        <shape>
            <solid android:color="?attr/colorError" />
            <corners
                android:topLeftRadius="@dimen/radius_sm"
                android:bottomLeftRadius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- Borde exterior hairline -->
    <item>
        <shape>
            <stroke
                android:width="@dimen/border_hairline"
                android:color="?attr/colorError" />
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
