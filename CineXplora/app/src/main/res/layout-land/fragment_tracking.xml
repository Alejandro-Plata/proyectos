<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Panel izquierdo: filtros sobre superficie elevada -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:background="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_search_title"
                    app:startIconDrawable="@drawable/ic_search"
                    app:endIconMode="clear_text"
                    android:layout_marginBottom="@dimen/space_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_sort_by"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        android:layout_marginEnd="@dimen/space_xs" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSort"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnSortDateDesc">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSortDateDesc"
                            style="@style/CineXplora.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="↓"
                            android:contentDescription="@string/sort_date_desc"
                            android:tooltipText="@string/tooltip_sort_date_desc"
                            app:icon="@drawable/ic_sort_date_desc"
                            app:iconGravity="textStart"
                            app:iconSize="14dp"
                            app:iconPadding="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSortDateAsc"
                            style="@style/CineXplora.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="↑"
                            android:contentDescription="@string/sort_date_asc"
                            android:tooltipText="@string/tooltip_sort_date_asc"
                            app:icon="@drawable/ic_sort_date_asc"
                            app:iconGravity="textStart"
                            app:iconSize="14dp"
                            app:iconPadding="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSortRatingDesc"
                            style="@style/CineXplora.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="↓"
                            android:contentDescription="@string/sort_rating_desc"
                            android:tooltipText="@string/tooltip_sort_rating_desc"
                            app:icon="@drawable/ic_sort_rating_desc"
                            app:iconGravity="textStart"
                            app:iconSize="14dp"
                            app:iconPadding="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSortRatingAsc"
                            style="@style/CineXplora.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="↑"
                            android:contentDescription="@string/sort_rating_asc"
                            android:tooltipText="@string/tooltip_sort_rating_asc"
                            app:icon="@drawable/ic_sort_rating_asc"
                            app:iconGravity="textStart"
                            app:iconSize="14dp"
                            app:iconPadding="2dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdvancedFilters"
                    style="@style/CineXplora.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_advanced_filters"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="?android:attr/listDivider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false">

                <LinearLayout
                    android:id="@+id/layoutAdvancedFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="@dimen/space_md"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_date_range"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/space_xs" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/space_sm">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDateFrom"
                            style="@style/CineXplora.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:hint="@string/hint_date_from">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDateFrom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDateTo"
                            style="@style/CineXplora.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_date_to">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDateTo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rating_range"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/space_xs" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_rating_min"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <RatingBar
                            android:id="@+id/ratingBarMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:rating="0"
                            android:progressTint="?attr/colorPrimary"
                            android:secondaryProgressTint="?android:attr/textColorSecondary"
                            android:layout_marginBottom="@dimen/space_sm"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_rating_max"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <RatingBar
                            android:id="@+id/ratingBarMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:rating="0"
                            android:progressTint="?attr/colorPrimary"
                            android:secondaryProgressTint="?android:attr/textColorSecondary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApplyFilters"
                            style="@style/CineXplora.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:text="@string/btn_apply_filters" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearFilters"
                            style="@style/CineXplora.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_clear_filters" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Divisor vertical -->
        <View
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider" />

        <!-- Panel derecho: lista de seguimientos -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6">

            <TextView
                android:id="@+id/tvNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_results"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_2xl" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTracking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?android:attr/textColorSecondary"
                    android:alpha="0.4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/msg_no_tracking_yet"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/msg_press_plus"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorHint" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/btn_save_tracking"
        app:elevation="4dp"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary"
        app:srcCompat="@drawable/ic_add_fab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
