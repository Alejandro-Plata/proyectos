<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:fillViewport="true"
            android:background="?android:attr/windowBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="@dimen/space_2xl"
                android:paddingVertical="@dimen/space_xl">

                <TextView
                    style="@style/CineXplora.Text.BodyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Introduce tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña."
                    android:layout_marginBottom="@dimen/space_xl" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmailReset"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Correo electrónico"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="?android:attr/textColorSecondary"
                    android:layout_marginBottom="@dimen/space_xl">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvErrorReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Error"
                    android:textColor="?attr/colorError"
                    android:background="@drawable/bg_error_banner"
                    android:padding="@dimen/space_md"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/space_lg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendReset"
                    style="@style/CineXplora.Button.Large"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:text="Enviar enlace"
                    android:layout_marginBottom="@dimen/space_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/CineXplora.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Volver al inicio de sesión"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutLoadingReset"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0D0F13"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="10dp">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorPrimary" />
    </FrameLayout>

</FrameLayout>
