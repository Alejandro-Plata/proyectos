<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="?android:attr/windowBackground">

    <!-- Panel izquierdo: titulo y segmented control vertical -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="@dimen/space_lg">

        <TextView
            style="@style/CineXplora.Text.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_watchlist"
            android:layout_marginBottom="@dimen/space_xl" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnAll">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAll"
                style="@style/CineXplora.Button.Segment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMovies"
                style="@style/CineXplora.Button.Segment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/type_movie" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeries"
                style="@style/CineXplora.Button.Segment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/type_tv_show" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Divisor vertical -->
    <View
        android:layout_width="@dimen/divider_height"
        android:layout_height="match_parent"
        android:background="?android:attr/listDivider" />

    <!-- Panel derecho: grid de contenidos -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWatchlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_popcorn_empty"
                android:alpha="0.85"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                style="@style/CineXplora.Text.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/empty_watchlist_title" />

            <TextView
                style="@style/CineXplora.Text.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/empty_watchlist_subtitle"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToExplore"
                style="@style/CineXplora.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/btn_explore_catalog" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
