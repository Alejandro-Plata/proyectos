<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Panel izquierdo: perfil de usuario -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingVertical="@dimen/space_xl"
            android:gravity="center_horizontal">

            <TextView
                style="@style/CineXplora.Text.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_settings"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- Tarjeta de perfil -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/card_border_width"
                app:strokeColor="?android:attr/listDivider"
                app:cardBackgroundColor="?attr/colorSurface"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/space_lg">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileSettings"
                        android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeWidth="2dp"
                        app:strokeColor="?android:attr/listDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePhoto"
                        style="@style/CineXplora.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_change_photo"
                        android:layout_marginTop="@dimen/space_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nombre de usuario -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_username"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                style="@style/CineXplora.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="@dimen/space_xl">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_username_placeholder"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Cerrar sesion -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_logout"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorError"
                android:textColor="?attr/colorOnPrimary"
                app:cornerRadius="@dimen/radius_sm"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Divisor vertical -->
        <View
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider" />

        <!-- Panel derecho: ajustes de la app -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingVertical="@dimen/space_xl">

            <!-- Idioma -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_preferred_language"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="@dimen/space_sm" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_spinner_outline"
                android:paddingStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- Almacenamiento de datos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_data_storage"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="@dimen/space_md" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_wifi_only"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_wifi_subtitle"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="?android:attr/textColorPrimary"
                    app:trackTint="?attr/colorPrimary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="?android:attr/listDivider"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- Apariencia -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_appearance"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnLight"
                android:layout_marginBottom="@dimen/space_xl">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLight"
                    style="@style/CineXplora.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_light"
                    app:icon="@drawable/ic_sun"
                    app:iconTint="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDark"
                    style="@style/CineXplora.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_dark"
                    app:icon="@drawable/ic_moon"
                    app:iconTint="?attr/colorPrimary" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Acciones de guardado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/CineXplora.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_save_preferences"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/CineXplora.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_reset_defaults"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
