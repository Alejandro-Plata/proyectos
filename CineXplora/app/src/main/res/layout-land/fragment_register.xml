<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Panel izquierdo: imagen de marca -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cinexplora_banner"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay"
                android:alpha="0.5" />

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:background="?attr/colorPrimary" />
        </FrameLayout>

        <!-- Divisor vertical -->
        <View
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider" />

        <!-- Panel derecho: formulario de registro -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:fillViewport="true"
            android:background="?android:attr/windowBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="@dimen/space_2xl"
                android:paddingVertical="@dimen/space_lg">

                <!-- Avatar de perfil -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/space_md">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileRegister"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeWidth="@dimen/card_border_width"
                        app:strokeColor="?android:attr/listDivider" />

                    <ImageButton
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_accent"
                        android:src="@drawable/ic_add_photo"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/label_add_photo" />
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_director_name"
                    app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                    android:layout_marginBottom="@dimen/space_md">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmailReg"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_email"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    android:layout_marginBottom="@dimen/space_md">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailReg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassReg"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    android:layout_marginBottom="@dimen/space_md">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassReg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPass"
                    style="@style/CineXplora.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_confirm_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    android:layout_marginBottom="@dimen/space_lg">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvErrorReg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_register"
                    android:textColor="?attr/colorError"
                    android:background="@drawable/bg_error_banner"
                    android:padding="@dimen/space_md"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/space_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    style="@style/CineXplora.Button.Large"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:text="@string/btn_register"
                    android:layout_marginBottom="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_md">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?android:attr/listDivider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_or_continue_with"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        android:paddingHorizontal="@dimen/space_md" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/googleSignInButton"
                    style="@style/CineXplora.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/btn_google_signin"
                    app:icon="@drawable/ic_google"
                    app:iconSize="20dp"
                    app:iconTint="@null"
                    android:layout_marginBottom="@dimen/space_xl" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/link_already_account"
                        android:textColor="?android:attr/textColorSecondary" />
                    <TextView
                        android:id="@+id/tvLoginLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/link_enter_here"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Overlay de carga -->
    <FrameLayout
        android:id="@+id/layoutLoadingReg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_cinema"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="10dp">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorPrimary" />
    </FrameLayout>
</FrameLayout>
